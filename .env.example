DATABASE_URL=postgresql+asyncpg://healing:healing@localhost:5432/healing
API_KEY=change-me
WORKER_POLL_SECONDS=1.0
CONFIDENCE_REVIEW_THRESHOLD=0.60
CONFIDENCE_DELIVERY_THRESHOLD=0.80
AI_PROVIDER=deterministic
WEBHOOK_SIGNING_SECRET=change-webhook-secret
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=10

# Used by the optional local Kafka event-backbone process (`make backbone`).
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_INPUT_TOPIC=enterprise.failures
KAFKA_DEAD_LETTER_TOPIC=enterprise.failures.dead-letter
KAFKA_CONSUMER_GROUP=auto-healing-agent-runtime
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
