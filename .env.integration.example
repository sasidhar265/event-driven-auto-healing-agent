# ART's governed internal PostgreSQL schema.
DATABASE_URL=postgresql+asyncpg://healing:change-me@database-host:5432/healing
API_KEY=replace-me

# Enable polling/writing to existing PostgreSQL tables. This may point to the
# same server as DATABASE_URL or a different PostgreSQL database.
EXTERNAL_POSTGRES_ENABLED=true
EXTERNAL_POSTGRES_URL=postgresql+asyncpg://integration_user:change-me@legacy-host:5432/operations
EXTERNAL_POLL_SECONDS=2
EXTERNAL_BATCH_SIZE=20

# Existing source event table and its column mapping.
EXTERNAL_EVENT_TABLE=operations.failure_events
EXTERNAL_EVENT_ID_COLUMN=id
EXTERNAL_EVENT_TYPE_COLUMN=event_type
EXTERNAL_EVENT_SOURCE_COLUMN=source
EXTERNAL_EVENT_SEVERITY_COLUMN=severity
EXTERNAL_EVENT_CORRELATION_COLUMN=correlation_key
EXTERNAL_EVENT_PAYLOAD_COLUMN=payload
EXTERNAL_EVENT_TENANT_COLUMN=tenant_id
EXTERNAL_EVENT_ACTOR_COLUMN=actor
EXTERNAL_EVENT_CREATED_COLUMN=created_at
EXTERNAL_EVENT_PROCESSED_COLUMN=art_ingested_at

# "insert": append suggestions to a separate configured result table.
EXTERNAL_RESULT_MODE=insert
EXTERNAL_RESULT_TABLE=operations.art_suggestions
EXTERNAL_RESULT_SUGGESTION_ID_COLUMN=suggestion_id
EXTERNAL_RESULT_EVENT_ID_COLUMN=event_id
EXTERNAL_RESULT_STATUS_COLUMN=status
EXTERNAL_RESULT_CONFIDENCE_COLUMN=confidence
EXTERNAL_RESULT_AGENT_COLUMN=agent_type
EXTERNAL_RESULT_PAYLOAD_COLUMN=suggestion
EXTERNAL_RESULT_CREATED_COLUMN=created_at

# "update_event": instead update only these two allow-listed columns on the
# original event table. Set EXTERNAL_RESULT_MODE=update_event to use them.
EXTERNAL_EVENT_RESULT_COLUMN=art_suggestion
EXTERNAL_EVENT_RESULT_STATUS_COLUMN=art_status
